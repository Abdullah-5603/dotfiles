#!/usr/bin/env bash
set -euo pipefail

theme_dir="${HOME}/.config/omarchy/current/theme"
kitty_theme="${theme_dir}/kitty.conf"
nvim_signal="${XDG_CACHE_HOME:-${HOME}/.cache}/nvim/omarchy-theme-reload"

if [[ -f "$kitty_theme" ]] && command -v kitty >/dev/null 2>&1; then
    kitty @ --password nullx set-colors --all --configured "$kitty_theme" >/dev/null 2>&1 || true
fi

mkdir -p "$(dirname "$nvim_signal")"
date +%s%N > "$nvim_signal"
