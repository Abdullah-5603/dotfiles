# ─────────────────────────────────────────────
# Oh-My-Zsh Config (portable / cross-distro)
# ─────────────────────────────────────────────

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"  # simple, fast, and elegant theme

# Plugins
plugins=(
  git
  zsh-autosuggestions
  zsh-syntax-highlighting
  zsh-history-substring-search
)

source $ZSH/oh-my-zsh.sh

# ─────────────────────────────────────────────
# Aliases
# ─────────────────────────────────────────────
# Use eza (newer) or exa (older) for ls replacement
if command -v eza >/dev/null 2>&1; then
    alias ls='eza -l --no-time --no-filesize --icons --group-directories-first --color=always'
    alias ll='eza -lah --icons --group-directories-first --time-style=long-iso'
elif command -v exa >/dev/null 2>&1; then
    alias ls='exa -l --no-time --no-filesize --icons --group-directories-first --color=always'
    alias ll='exa -lah --icons --group-directories-first --time-style=long-iso'
fi

# Use bat for cat (handle batcat on Debian/Ubuntu)
if command -v bat >/dev/null 2>&1; then
    alias cat='bat --paging=never'
elif command -v batcat >/dev/null 2>&1; then
    alias cat='batcat --paging=never'
fi

alias grep='grep --color=auto'
alias c='clear'
alias cls='clear && printf "\033c"'
alias ..='cd ..'
alias ...='cd ../..'

# Package manager aliases (auto-detected)
if command -v pacman >/dev/null 2>&1; then
    alias mupdate='sudo pacman -Syu'
    alias minstall='sudo pacman -S'
    alias mremove='sudo pacman -Rns'
    alias fixlock='sudo rm /var/lib/pacman/db.lck'
    alias paclog='less /var/log/pacman.log'
    command -v pkgfile >/dev/null 2>&1 && alias findpkg='pkgfile -v'
elif command -v apt >/dev/null 2>&1; then
    alias mupdate='sudo apt update && sudo apt upgrade'
    alias minstall='sudo apt install'
    alias mremove='sudo apt remove'
elif command -v dnf >/dev/null 2>&1; then
    alias mupdate='sudo dnf upgrade'
    alias minstall='sudo dnf install'
    alias mremove='sudo dnf remove'
elif command -v zypper >/dev/null 2>&1; then
    alias mupdate='sudo zypper update'
    alias minstall='sudo zypper install'
    alias mremove='sudo zypper remove'
elif command -v apk >/dev/null 2>&1; then
    alias mupdate='sudo apk upgrade'
    alias minstall='sudo apk add'
    alias mremove='sudo apk del'
elif command -v brew >/dev/null 2>&1; then
    alias mupdate='brew update && brew upgrade'
    alias minstall='brew install'
    alias mremove='brew uninstall'
fi

alias please='sudo $(history -p !!)'
alias editz='${EDITOR:-nvim} ~/.zshrc && source ~/.zshrc'
alias reload='source ~/.zshrc'
command -v nvim >/dev/null 2>&1 && alias vim='nvim'
command -v nginx >/dev/null 2>&1 && alias nginx-reload='sudo nginx -t && sudo nginx -s reload'

# ─────────────────────────────────────────────
# FZF Integration
# ─────────────────────────────────────────────
if command -v fzf >/dev/null 2>&1; then
  if command -v fd >/dev/null 2>&1; then
    export FZF_DEFAULT_COMMAND='fd --type f'
  elif command -v fdfind >/dev/null 2>&1; then
    export FZF_DEFAULT_COMMAND='fdfind --type f'
  fi
  [ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
fi

# ─────────────────────────────────────────────
# History Settings
# ─────────────────────────────────────────────
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt hist_ignore_all_dups share_history

# ─────────────────────────────────────────────
# Environment & Editor
# ─────────────────────────────────────────────
export EDITOR="nvim"
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export TERM=xterm-256color

# ─────────────────────────────────────────────
# Autosuggestions & Syntax Highlight Colors
# ─────────────────────────────────────────────
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#555555'

# ─────────────────────────────────────────────
# Wayland (only when running a Wayland session)
# ─────────────────────────────────────────────
if [[ "$XDG_SESSION_TYPE" == "wayland" ]]; then
    export QT_QPA_PLATFORM=wayland
    export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
fi

# ─────────────────────────────────────────────
# NVM (Node Version Manager)
# ─────────────────────────────────────────────
export NVM_DIR="$HOME/.config/nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# ─────────────────────────────────────────────
# PATH
# ─────────────────────────────────────────────
export PATH="$HOME/bin:$HOME/.local/bin:$PATH"

# ─────────────────────────────────────────────
# Local / machine-specific overrides (not tracked)
# Put per-machine PATH entries, aliases, tokens, etc. here.
# ─────────────────────────────────────────────
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"
