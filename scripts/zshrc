# ─────────────────────────────────────────────
# Clean Oh-My-Zsh Config (Arch / AArch)
# ─────────────────────────────────────────────

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"  # simple, fast, and elegant theme

# Plugins
plugins=(
  git
  zsh-autosuggestions
  zsh-syntax-highlighting
  zsh-history-substring-search
)

source $ZSH/oh-my-zsh.sh

# ─────────────────────────────────────────────
# Aliases
# ─────────────────────────────────────────────
alias ls='exa -l --no-time --no-filesize --icons --group-directories-first --color=always'
alias ll='exa -lah --icons --group-directories-first --time-style=long-iso'
alias cat='bat --paging=never'
alias grep='grep --color=auto'
alias c='clear'
alias ..='cd ..'
alias ...='cd ../..'
alias mupdate='sudo pacman -Syu'
alias minstall='sudo pacman -S'
alias mremove='sudo pacman -Rns'
alias fixlock='sudo rm /var/lib/pacman/db.lck'
alias please='sudo $(history -p !!)'
alias editz='vim ~/.zshrc && source ~/.zshrc'
alias reload='source ~/.zshrc'
alias vim='nvim'
alias pset='sudo proton-switch'
alias mysql='mariadb'
alias sys_upgrade='sudo pacman -Syu'
alias nginx-reload='sudo nginx -t && sudo nginx -s reload'
alias ibus-setup='/usr/bin/python3 /usr/share/ibus/setup/main.py'

# ─────────────────────────────────────────────
# FZF Integration
# ─────────────────────────────────────────────
if command -v fzf >/dev/null 2>&1; then
  export FZF_DEFAULT_COMMAND='fd --type f'
  [ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
fi

# ─────────────────────────────────────────────
# History Settings
# ─────────────────────────────────────────────
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt hist_ignore_all_dups share_history

# ─────────────────────────────────────────────
# ⚙️ Environment & Editor
# ─────────────────────────────────────────────
export EDITOR="nvim"
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export PATH="$HOME/bin:$PATH"

# ─────────────────────────────────────────────
# Autosuggestions & Syntax Highlight Colors
# ─────────────────────────────────────────────
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#555555'
source ${ZSH_CUSTOM:-~/.oh-my-zsh/custom}/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# ─────────────────────────────────────────────
# Misc Shortcuts
# ─────────────────────────────────────────────
alias cls='clear && printf "\033c"'
alias paclog='cat /var/log/pacman.log | less'
alias findpkg='pkgfile -v'

export PATH="$PATH:/home/nprime/.config/composer/vendor/bin"

export NVM_DIR="$HOME/.config/nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion
